# CornCare Backend Environment Variables

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/corncare

# JWT Configuration
SECRET_KEY=your_super_secret_jwt_key_here_make_it_very_long_and_random_abc123def456ghi789
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration for Expert Notifications
CORNCARE_EMAIL=corncare.official@gmail.com
CORNCARE_EMAIL_PASSWORD=your_gmail_app_password_here

# Note: To get CORNCARE_EMAIL_PASSWORD:
# 1. Go to your Gmail account settings
# 2. Enable 2-Factor Authentication
# 3. Generate an "App Password" 
# 4. Use that app password here (not your regular Gmail password)

# Optional: Admin notification settings
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com

# Localization and inference options
# Response language: 'en' or 'hi'
RESPONSE_LANG=hi

# Enable test-time augmentation to improve robustness (1 to enable)
USE_TTA=1
TTA_ROT_DEGREES=15

# OOD gates (set 0 to disable if needed during tuning)
ENABLE_CENTROID_OOD=1
ENABLE_HEURISTIC_OOD=1
ENABLE_ENTROPY_CHECK=1
ENABLE_GAP_CHECK=1

# OOD thresholds (tune as needed)
CENTROID_THRESHOLD=20.0
MIN_CONFIDENCE=0.60
MAX_PREDICTION_ENTROPY=1.20
MIN_TOP2_CONFIDENCE_GAP=0.10

# Debug: return structured details on 400 responses
DEBUG_OOD_RESPONSES=0
